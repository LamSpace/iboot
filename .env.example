# ============================================================
# iBoot 0.6 多渠道通知 — 本地环境变量模板
# ============================================================
# 复制为 .env（或 ~/.config/iboot/notify.env）后填入真实值。
# .env 已被 .gitignore 忽略；本文件只含占位符，可以提交。
# ============================================================

# ========== 邮件（QQ / 163） ==========
# QQ:  smtp.qq.com:465
# 163: smtp.163.com:465
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
# 授权码，不是邮箱登录密码
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SSL_ENABLED=true
MAIL_STARTTLS_ENABLED=false
# 仅用于 smtp-test.py 的测试收件地址
MAIL_TEST_TO=

# ========== 钉钉自定义机器人 ==========
IBOOT_DINGTALK_ENABLED=true
# https://oapi.dingtalk.com/robot/send?access_token=xxxxx
IBOOT_DINGTALK_WEBHOOK=
# 加签 Secret，以 SEC 开头
IBOOT_DINGTALK_SECRET=

# ========== 短信（本期不启用） ==========
# 个人实名账号无法完成国内短信签名实名报备，
# 0.6 保留实现但默认关闭，测试使用 FakeSmsNotificationChannel。
IBOOT_SMS_ENABLED=false
IBOOT_SMS_ACCESS_KEY_ID=
IBOOT_SMS_ACCESS_KEY_SECRET=
IBOOT_SMS_SIGN_NAME=
IBOOT_SMS_TEMPLATE_CODE=
IBOOT_SMS_REGION=cn-hangzhou

# ========== 通知重试 ==========
IBOOT_NOTIFICATION_RETRY_MAX=5
IBOOT_NOTIFICATION_RETRY_BACKOFF_SECONDS=60
