# ============================================================
# iBoot 0.6 多渠道通知 — 本地环境变量模板
# ============================================================
# 复制为 .env（或 ~/.config/iboot/notify.env）后填入真实值。
# .env 已被 .gitignore 忽略；本文件只含占位符，可以提交。
# ============================================================

# ========== 邮件（QQ / 163） ==========
# QQ:  smtp.qq.com:465
# 163: smtp.163.com:465
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
# 授权码，不是邮箱登录密码
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SSL_ENABLED=true
MAIL_STARTTLS_ENABLED=false
# 仅用于 smtp-test.py 的测试收件地址
MAIL_TEST_TO=

# ========== 钉钉自定义机器人 ==========
IBOOT_DINGTALK_ENABLED=true
# https://oapi.dingtalk.com/robot/send?access_token=xxxxx
IBOOT_DINGTALK_WEBHOOK=
# 加签 Secret，以 SEC 开头
IBOOT_DINGTALK_SECRET=

# ========== 短信（本期不启用） ==========
# 个人实名账号无法完成国内短信签名实名报备，
# 0.6 保留实现但默认关闭，测试使用 FakeSmsNotificationChannel。
IBOOT_SMS_ENABLED=false
IBOOT_SMS_ACCESS_KEY_ID=
IBOOT_SMS_ACCESS_KEY_SECRET=
IBOOT_SMS_SIGN_NAME=
IBOOT_SMS_TEMPLATE_CODE=
IBOOT_SMS_REGION=cn-hangzhou

# ========== 通知重试 ==========
IBOOT_NOTIFICATION_RETRY_MAX=5
IBOOT_NOTIFICATION_RETRY_BACKOFF_SECONDS=60

# ============================================================
# iBoot 0.2 数据备份与恢复 — 本地环境变量模板
# ============================================================
# 功能默认关闭。启用前必须生成并填写主密钥；密钥丢失后备份无法解密。
# 生成方式：openssl rand -base64 32
IBOOT_BACKUP_ENABLED=false
IBOOT_BACKUP_ENCRYPTION_KEY=
# 本地默认通过 docker exec 复用 MySQL 容器内的 mysqldump
IBOOT_BACKUP_DOCKER_CONTAINER=iboot-mysql
# 备份源库与演练库前缀
IBOOT_BACKUP_DATABASE=iboot
IBOOT_BACKUP_RESTORE_SCHEMA=iboot_restore_drill
IBOOT_BACKUP_RESTORE_PREFIX=iboot_restore_
# 运行中记录超时重置阈值（分钟）
IBOOT_BACKUP_STALE_MINUTES=30
# 任务列表的数据权限范围来源（按注册中心服务名寻址，失败关闭）
IBOOT_JOB_SCOPE_URL=http://iboot-system/api/auth/scope
IBOOT_JOB_SCOPE_CACHE_SECONDS=60

# ============================================================
# iBoot 0.2 数据备份与恢复 — 本地环境变量
# ============================================================
# AES-256-GCM 主密钥（Base64 编码的 32 字节随机值）
# 生成：openssl rand -base64 32
#
IBOOT_BACKUP_ENCRYPTION_KEY=""

# ========== iBoot 1.1 AI 工作台 — 百炼(DashScope) ==========
# 申请：百炼控制台 → API-KEY 管理（华北2-北京）
# 模型：对话 qwen3.8-flash；Embedding text-embedding-v4
# 建议对话与 Embedding 分别建 Key，便于按 Key 设置预算熔断
DASHSCOPE_CHAT_API_KEY=
DASHSCOPE_EMBEDDING_API_KEY=
# 接入点默认 https://dashscope.aliyuncs.com/compatible-mode
# 切换地域或供应商时可在 .env 中覆盖 DASHSCOPE_BASE_URL

# ============================================================
# iBoot 1.2 知识库 RAG — 扫描件 OCR（百炼 Qwen-OCR，默认关闭）
# ============================================================
# 推荐 qwen3.5-ocr：当前 OCR 专用模型，支持 OpenAI 兼容
# /chat/completions + image_url（URL 或 base64 data URL）。
# 若当前接入点/账号尚未开放该模型，回退到：
#   IBOOT_AI_OCR_MODEL=qwen-vl-ocr-2025-11-20
# 仅对没有可提取文本的扫描页调用；文本类 PDF/Word 不送云。
IBOOT_AI_OCR_ENABLED=false
IBOOT_AI_OCR_MODEL=qwen3.5-ocr

# 建议单独建 Key，便于单独设置预算熔断；
# 留空时代码回退到 DASHSCOPE_CHAT_API_KEY。
DASHSCOPE_OCR_API_KEY=

# OCR 专用接入点。留空时复用 DASHSCOPE_BASE_URL（代码会补 /v1）。
# qwen3.5-ocr 若在旧接入点不可用，改为百炼控制台的工作空间域名：
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
IBOOT_AI_OCR_BASE_URL=

# 扫描页渲染与成本护栏
IBOOT_AI_OCR_DPI=150
IBOOT_AI_OCR_MAX_PAGES=50
IBOOT_AI_OCR_DAILY_PAGE_LIMIT=200
IBOOT_AI_OCR_TIMEOUT_SECONDS=60

# ========== iBoot 1.2 知识库 RAG — MySQL / ES / MinIO ==========
# 本地默认值；生产环境通过密钥管理注入
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
IBOOT_AI_MYSQL_DATABASE=iboot
ELASTICSEARCH_URIS=http://localhost:9200
IBOOT_AI_MINIO_ENDPOINT=http://localhost:9000
IBOOT_AI_MINIO_ACCESS_KEY=minioadmin
IBOOT_AI_MINIO_SECRET_KEY=minioadmin
IBOOT_AI_MINIO_BUCKET=iboot-ai
# 数据权限 scope 地址：按注册中心服务名寻址，覆盖值也必须是服务名形式
IBOOT_AI_SCOPE_URL=http://iboot-system/api/auth/scope
IBOOT_AI_SCOPE_CACHE_SECONDS=60
IBOOT_AI_RAG_ENABLED=true

# ========== iBoot 1.4 知识图谱 — Neo4j ==========
# 仅 docker compose --profile graph up -d neo4j 时需要；服务默认关闭
NEO4J_PASSWORD=iboot123456
IBOOT_AI_GRAPH_ENABLED=false
IBOOT_AI_GRAPH_URI=bolt://localhost:7687
IBOOT_AI_GRAPH_USERNAME=neo4j
IBOOT_AI_GRAPH_PASSWORD=iboot123456

# ========== 阶段 2 消息与通知服务 — iboot-notify ==========
# 管理端调用通知服务的内部登记端点所需的共享密钥；两端必须一致，缺失时端点失败关闭
IBOOT_NOTIFY_INTERNAL_TOKEN=iboot-dev-internal-token
IBOOT_NOTIFY_BASE_URL=http://localhost:8084
# SSE 跨实例广播：单实例用 local；多实例改为 redis
IBOOT_PUSH_BROADCASTER=local

# ========== 阶段 2 运维控制台 — iboot-ops ==========
# 控制台使用独立的 Basic 认证；密码为空时服务拒绝启动
# dev-init.sh 在本地开发中会为留空密码补默认值 ops123；生产必须显式注入
IBOOT_OPS_USER=ops
IBOOT_OPS_PASSWORD=
# 本地开发默认关闭控制台认证；生产必须设为 true
IBOOT_OPS_SECURITY_ENABLED=false
# 设为 false 可在本地跳过运维控制台（节省内存）
IBOOT_OPS_ENABLED=true

# ========== 阶段 2 收尾 — Sentinel Dashboard ==========
# 本地开发默认关闭登录（docker-compose.yml 的 JAVA_TOOL_OPTIONS 为 auth.enabled=false）。
# 非本地环境必须叠加 docker/docker-compose.prod.yml 并填写以下两项；缺失时 compose 直接失败。
SENTINEL_DASHBOARD_USER=
SENTINEL_DASHBOARD_PASSWORD=
