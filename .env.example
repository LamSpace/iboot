# ============================================================
# iBoot 0.6 多渠道通知 — 本地环境变量模板
# ============================================================
# 复制为 .env（或 ~/.config/iboot/notify.env）后填入真实值。
# .env 已被 .gitignore 忽略；本文件只含占位符，可以提交。
# ============================================================

# ========== 开发者 CLI / 认证客户端 ==========
# 开发者 CLI 使用授权码 + PKCE，回调固定为本地 loopback。
# 仅在需要改端口或客户端标识时覆盖；门户客户端配置保持默认。
IBOOT_AUTH_CLI_CLIENT_ID=iboot-cli
IBOOT_AUTH_CLI_REDIRECT_URI=http://127.0.0.1:8765/callback
# 个人访问令牌：默认有效期、最大有效期（天）与每用户活动令牌上限
IBOOT_AUTH_PAT_DEFAULT_DAYS=30
IBOOT_AUTH_PAT_MAX_DAYS=90
IBOOT_AUTH_PAT_MAX_PER_USER=10

# ========== 本地 TLS ==========
# 默认启用；设为 false 仅用于排障，回归与验收不得在该模式下判定通过。
IBOOT_TLS_ENABLED=true
# 宿主机开发公开来源；dev-init.sh 据此推导认证 issuer、回调与登出地址。
# Docker 全量部署由 compose 覆盖为 https://localhost。
IBOOT_PUBLIC_ORIGIN=https://localhost:5173
# Docker 门户构建期注入的 OIDC issuer；通常保持 https://localhost
IBOOT_PORTAL_OIDC_ISSUER=https://localhost
# 证书目录；留空时使用 docker/certs（执行 scripts/tls-init.sh 生成）
IBOOT_TLS_CERT_DIR=
# CLI 的 Java 信任库；留空时使用 JDK 默认信任库。本地开发填写 docker/certs/truststore.p12
IBOOT_CLI_TRUSTSTORE=
IBOOT_CLI_TRUSTSTORE_PASSWORD=changeit
# 回归脚本使用的 PEM CA；留空时使用 docker/certs/ca/rootCA.pem
REG_CACERT=
# 内部服务 TLS；B2 不提供 false 回退（false 会导致 dev-init 启动前失败）
IBOOT_INTERNAL_TLS_ENABLED=true
# JDBC TLS 参数；测试或明文排障时可改为 useSSL=false...
MYSQL_SSL_PARAMS="sslMode=VERIFY_IDENTITY&requireSSL=true&serverTimezone=UTC&characterEncoding=utf8"
REDIS_SSL_ENABLED=true
# Redis 必须认证；每服务 ACL 口令见上方 MIDDLEWARE_*_PASSWORD。
# exporter 使用受限命令集的独立账号；健康检查也使用该账号。
REDIS_EXPORTER_PASSWORD=
# 内部契约快照/回归 CA；留空时使用 REG_CACERT
SVC_CACERT=

# ========== 邮件（QQ / 163） ==========
# QQ:  smtp.qq.com:465
# 163: smtp.163.com:465
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
# 授权码，不是邮箱登录密码
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SSL_ENABLED=true
MAIL_STARTTLS_ENABLED=false
# 仅用于 smtp-test.py 的测试收件地址
MAIL_TEST_TO=

# ========== 钉钉自定义机器人 ==========
IBOOT_DINGTALK_ENABLED=true
# https://oapi.dingtalk.com/robot/send?access_token=xxxxx
IBOOT_DINGTALK_WEBHOOK=
# 加签 Secret，以 SEC 开头
IBOOT_DINGTALK_SECRET=

# ========== 短信（本期不启用） ==========
# 个人实名账号无法完成国内短信签名实名报备，
# 0.6 保留实现但默认关闭，测试使用 FakeSmsNotificationChannel。
IBOOT_SMS_ENABLED=false
IBOOT_SMS_ACCESS_KEY_ID=
IBOOT_SMS_ACCESS_KEY_SECRET=
IBOOT_SMS_SIGN_NAME=
IBOOT_SMS_TEMPLATE_CODE=
IBOOT_SMS_REGION=cn-hangzhou

# ========== 通知重试 ==========
IBOOT_NOTIFICATION_RETRY_MAX=5
IBOOT_NOTIFICATION_RETRY_BACKOFF_SECONDS=60

# ============================================================
# iBoot 0.2 数据备份与恢复 — 本地环境变量模板
# ============================================================
# 功能默认关闭。启用前必须生成并填写主密钥；密钥丢失后备份无法解密。
# 生成方式：openssl rand -base64 32
IBOOT_BACKUP_ENABLED=false
IBOOT_BACKUP_ENCRYPTION_KEY=
# 本地默认通过 docker exec 复用 MySQL 容器内的 mysqldump
IBOOT_BACKUP_DOCKER_CONTAINER=iboot-mysql
# 备份源库与演练库前缀
IBOOT_BACKUP_DATABASE=iboot
IBOOT_BACKUP_RESTORE_SCHEMA=iboot_restore_drill
IBOOT_BACKUP_RESTORE_PREFIX=iboot_restore_
# 运行中记录超时重置阈值（分钟）
IBOOT_BACKUP_STALE_MINUTES=30
# 任务列表的数据权限范围来源（按注册中心服务名寻址，失败关闭）
IBOOT_JOB_SCOPE_URL=https://iboot-system/api/auth/scope
IBOOT_JOB_SCOPE_CACHE_SECONDS=60

# ============================================================
# iBoot 0.2 数据备份与恢复 — 本地环境变量
# ============================================================
# AES-256-GCM 主密钥（Base64 编码的 32 字节随机值）
# 生成：openssl rand -base64 32
#
IBOOT_BACKUP_ENCRYPTION_KEY=""

# ========== iBoot 1.1 AI 工作台 — 百炼(DashScope) ==========
# 申请：百炼控制台 → API-KEY 管理（华北2-北京）
# 模型：对话 qwen3.8-flash；Embedding text-embedding-v4
# 建议对话与 Embedding 分别建 Key，便于按 Key 设置预算熔断
DASHSCOPE_CHAT_API_KEY=
DASHSCOPE_EMBEDDING_API_KEY=
# 接入点默认 https://dashscope.aliyuncs.com/compatible-mode
# 切换地域或供应商时可在 .env 中覆盖 DASHSCOPE_BASE_URL

# ============================================================
# iBoot 1.2 知识库 RAG — 扫描件 OCR（百炼 Qwen-OCR，默认关闭）
# ============================================================
# 推荐 qwen3.5-ocr：当前 OCR 专用模型，支持 OpenAI 兼容
# /chat/completions + image_url（URL 或 base64 data URL）。
# 若当前接入点/账号尚未开放该模型，回退到：
#   IBOOT_AI_OCR_MODEL=qwen-vl-ocr-2025-11-20
# 仅对没有可提取文本的扫描页调用；文本类 PDF/Word 不送云。
IBOOT_AI_OCR_ENABLED=false
IBOOT_AI_OCR_MODEL=qwen3.5-ocr

# 建议单独建 Key，便于单独设置预算熔断；
# 留空时代码回退到 DASHSCOPE_CHAT_API_KEY。
DASHSCOPE_OCR_API_KEY=

# OCR 专用接入点。留空时复用 DASHSCOPE_BASE_URL（代码会补 /v1）。
# qwen3.5-ocr 若在旧接入点不可用，改为百炼控制台的工作空间域名：
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
IBOOT_AI_OCR_BASE_URL=

# 扫描页渲染与成本护栏
IBOOT_AI_OCR_DPI=150
IBOOT_AI_OCR_MAX_PAGES=50
IBOOT_AI_OCR_DAILY_PAGE_LIMIT=200
IBOOT_AI_OCR_TIMEOUT_SECONDS=60

# ========== AI 智能体与知识图谱 ==========
# 智能体编排：开启后 /api/ai/agent/** 才注册，门户“智能体/智能体管理”菜单可用。
IBOOT_AI_AGENT_ENABLED=true
# 知识图谱：需要 Neo4j（compose 的 graph profile），默认关闭。
IBOOT_AI_GRAPH_ENABLED=false

# ========== iBoot 1.2 知识库 RAG — MySQL / ES / Silo ==========
# 每服务中间件身份：同一服务在 MySQL/Redis/Nacos 使用同一账号名 iboot_<service>。
# 每个口令必须非空，缺失时编排在拉起容器前失败；空值不得提交到仓库。
# 本地开发允许一个服务的三类中间件复用同一口令；生产建议按组件覆盖。
MIDDLEWARE_SYSTEM_PASSWORD=
MIDDLEWARE_WORKFLOW_PASSWORD=
MIDDLEWARE_FILE_PASSWORD=
MIDDLEWARE_NOTIFY_PASSWORD=
MIDDLEWARE_JOB_PASSWORD=
MIDDLEWARE_MONITOR_PASSWORD=
MIDDLEWARE_AUTH_PASSWORD=
MIDDLEWARE_AI_PASSWORD=
MIDDLEWARE_GATEWAY_PASSWORD=
MIDDLEWARE_OPS_PASSWORD=
# MySQL：root 只用于初始化与迁移，不注入业务服务。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_EXPORTER_USER=iboot_exporter
MYSQL_EXPORTER_PASSWORD=
MYSQL_ROOT_PASSWORD=
IBOOT_AI_MYSQL_DATABASE=iboot
# ES 只接受 HTTPS + 认证；业务服务按用途使用专用账号，由 es-users-init 幂等创建。
ELASTIC_PASSWORD=iboot-dev-elastic
ELASTICSEARCH_URIS=https://localhost:9200
# 宿主机模式由 dev-init.sh 按服务注入；留空时不会回退到 elastic 超级用户
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ES_AI_PASSWORD=iboot-dev-es-ai
ES_NOTIFY_PASSWORD=iboot-dev-es-notify
ES_MONITOR_PASSWORD=iboot-dev-es-monitor
ES_LOGSTASH_PASSWORD=iboot-dev-es-logstash
ES_GRAFANA_PASSWORD=iboot-dev-es-grafana
ES_EXPORTER_PASSWORD=iboot-dev-es-exporter
IBOOT_AI_SILO_ENDPOINT=https://localhost:9000
# Silo 根凭据由 .env 注入；不再提供可用的 minioadmin 默认值。
# 根账号只用于初始化、桶管理与运维，不注入业务服务。
SILO_ROOT_USER=
SILO_ROOT_PASSWORD=
# 文件与 AI 服务的桶级账号；dev-init 在宿主机模式按服务注入，compose 同理。
SILO_FILE_ACCESS_KEY=iboot_file
SILO_FILE_SECRET_KEY=
# 备份任务读取/写入文件桶，与文件服务共享桶但仍使用独立身份。
SILO_JOB_ACCESS_KEY=iboot_job
SILO_JOB_SECRET_KEY=
SILO_AI_ACCESS_KEY=iboot_ai
SILO_AI_SECRET_KEY=
# 手工运行单个服务时可直接填写；受管启动会覆盖为上面的服务账号。
IBOOT_AI_SILO_ACCESS_KEY=
IBOOT_AI_SILO_SECRET_KEY=
IBOOT_AI_SILO_BUCKET=iboot-ai

# ========== 文件服务存储（宿主机开发默认值） ==========
# Docker Compose 会覆盖存储类型与内网端点；宿主机需要本地磁盘时改为 local
IBOOT_FILE_STORAGE_TYPE=silo
IBOOT_FILE_SILO_ENDPOINT=https://localhost:9000
IBOOT_FILE_SILO_PUBLIC_ENDPOINT=https://localhost:9000
# 预签名区域；默认 us-east-1，显式指定可避免向对外地址发起区域查询
# IBOOT_FILE_SILO_REGION=us-east-1
# 生产环境建议只通过环境变量或密钥管理注入
IBOOT_FILE_SILO_ACCESS_KEY=
IBOOT_FILE_SILO_SECRET_KEY=
IBOOT_FILE_SILO_BUCKET=iboot-files
# 数据权限 scope 地址：按注册中心服务名寻址，覆盖值也必须是服务名形式
IBOOT_AI_SCOPE_URL=https://iboot-system/api/auth/scope
IBOOT_AI_SCOPE_CACHE_SECONDS=60
IBOOT_AI_RAG_ENABLED=true

# ========== iBoot 1.4 知识图谱 — Neo4j ==========
# 仅 docker compose --profile graph up -d neo4j 时需要；服务默认关闭。
# 口令必须从环境注入；已有数据卷不会因改变该变量而自动改口令，迁移步骤见 docs/27。
NEO4J_PASSWORD=iboot-dev-neo4j
IBOOT_AI_GRAPH_ENABLED=false
IBOOT_AI_GRAPH_URI=bolt+s://localhost:7687
IBOOT_AI_GRAPH_USERNAME=neo4j

# ========== 阶段 2 消息与通知服务 — iboot-notify ==========
# 管理端调用通知服务的内部登记端点所需的共享密钥；两端必须一致，缺失时端点失败关闭
IBOOT_NOTIFY_INTERNAL_TOKEN=iboot-dev-internal-token
IBOOT_NOTIFY_BASE_URL=https://localhost:8084
# SSE 跨实例广播：单实例用 local；多实例改为 redis
IBOOT_PUSH_BROADCASTER=local

# ========== 阶段 2 运维控制台 — iboot-ops ==========
# 控制台使用独立的 Basic 认证；密码为空时服务拒绝启动
# dev-init.sh 在本地开发中会为留空密码补默认值 ops123；生产必须显式注入
IBOOT_OPS_USER=ops
IBOOT_OPS_PASSWORD=
# 本地开发默认关闭控制台认证；生产必须设为 true
IBOOT_OPS_SECURITY_ENABLED=false
# 设为 false 可在本地跳过运维控制台（节省内存）
IBOOT_OPS_ENABLED=true

# ========== 阶段 2 收尾 — Kafka 日志管道 ==========
# 集中日志投递开关；dev-init.sh 默认启动 Kafka/Logstash 并开启，运行日志页面依赖该链路。
# 资源紧张时可设为 false，应用只输出控制台与本地文件。
IBOOT_LOGGING_KAFKA_ENABLED=true
# 宿主机进程默认 localhost:29092；容器内由 compose 注入 kafka:9092
IBOOT_LOGGING_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Kafka 只提供 SASL_SSL；宿主机信任库由 tls-init.sh 生成。
# SASL/PLAIN 口令只允许字母、数字、`-`、`_`，避免 JAAS 解析歧义。
IBOOT_LOGGING_KAFKA_SECURITY_PROTOCOL=SASL_SSL
IBOOT_LOGGING_KAFKA_SASL_MECHANISM=PLAIN
IBOOT_LOGGING_KAFKA_SASL_USERNAME=iboot_log
IBOOT_LOGGING_KAFKA_TRUSTSTORE_LOCATION=docker/certs/truststore.p12
IBOOT_LOGGING_KAFKA_TRUSTSTORE_PASSWORD=changeit
IBOOT_LOGGING_KAFKA_TRUSTSTORE_TYPE=PKCS12
# Kafka 账号口令：节点间、业务日志生产、Logstash 消费、运维工具分别独立
KAFKA_BROKER_PASSWORD=
KAFKA_LOG_PASSWORD=
KAFKA_LOGSTASH_PASSWORD=
KAFKA_TOOLS_PASSWORD=

# ========== 可观测平台 ==========
# dev-init.sh 默认启动 Prometheus/Grafana/Kibana/Alertmanager/Thanos 与 exporter。
# 资源紧张时可设为 false，只保留开发必需中间件。
IBOOT_OBSERVABILITY_ENABLED=true

# ========== 阶段 2 收尾 — RocketMQ ==========
# ========== Nacos TLS ==========
# Nacos 3.3 的 8848/8849 与 gRPC 9848/9849 只接受 TLS；证书由 tls-init.sh 生成
NACOS_ADDR=localhost:8848
# 客户端 HTTP 登录需要保留 https 方案；gRPC 仍使用 8848→9848 端口偏移。
NACOS_SERVER_ADDR=https://localhost:8848
# 客户端与服务端鉴权：服务使用受管账号注册/拉取配置，管理脚本先登录再写入。
NACOS_USERNAME=iboot
NACOS_PASSWORD=
NACOS_ADMIN_PASSWORD=
# 鉴权令牌与服务器身份；留空时 compose 启动失败，不留可用默认值。
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=iboot
NACOS_AUTH_IDENTITY_VALUE=iboot
# sentinel-init.sh 使用的 CA（默认已是 docker/certs/ca/rootCA.pem）
NACOS_CACERT=docker/certs/ca/rootCA.pem
# 门户控制台跳转地址（Docker 全栈使用 https）
SYS_NACOS_CONSOLE_URL=https://localhost:8849

# 宿主机进程默认 localhost:18081（RocketMQ TLS 入口）；容器内由 compose 注入 rocketmq-tls:8081
IBOOT_ROCKETMQ_ENDPOINTS=localhost:18081
# TLS-only 入口：客户端不校验服务端证书，明文连接被 rocketmq-tls 拒绝
IBOOT_ROCKETMQ_SSL_ENABLED=true
# ACL 2.0：运维账号只用于初始化与排障，应用账号只拥有自己的 topic 权限。
ROCKETMQ_ADMIN_ACCESS_KEY=iboot_rocketmq
ROCKETMQ_ADMIN_SECRET_KEY=
ROCKETMQ_WORKFLOW_ACCESS_KEY=iboot_workflow
ROCKETMQ_WORKFLOW_SECRET_KEY=
ROCKETMQ_NOTIFY_ACCESS_KEY=iboot_notify
ROCKETMQ_NOTIFY_SECRET_KEY=
# 设为 false 可跳过 RocketMQ 中间件；审批仍可提交，通知事件保留在 outbox
IBOOT_ROCKETMQ_ENABLED=true
# 回滚或排空 outbox 时暂停中继
IBOOT_WORKFLOW_OUTBOX_ENABLED=true

# ========== 阶段 2 收尾 — Seata 分布式事务 ==========
# 本地开发默认开启；seata-server 由 compose 常驻。
# 宿主机进程默认 localhost:8091；容器内由 compose 注入 seata-server:8091
SEATA_SERVER_ADDR=localhost:8091
IBOOT_SEATA_ENABLED=true
# 审批服务与系统服务之间的内部扣减端点共享密钥；两端必须一致，缺失时失败关闭
IBOOT_SYSTEM_INTERNAL_TOKEN=iboot-dev-internal-token
# 系统服务地址（宿主机直连为 localhost:8080；容器内由 compose 覆盖为 http://iboot-system）
IBOOT_SYSTEM_BASE_URL=https://localhost:8080

# ========== 阶段 2 收尾 — Sentinel Dashboard ==========
# 本地开发默认关闭登录（docker-compose.yml 的 JAVA_TOOL_OPTIONS 为 auth.enabled=false）。
# 非本地环境必须叠加 docker/docker-compose.prod.yml 并填写以下两项；缺失时 compose 直接失败。
SENTINEL_DASHBOARD_USER=
SENTINEL_DASHBOARD_PASSWORD=

# ========== 阶段 2 收尾 — SkyWalking APM 对比实验 ==========
# 辅助观测栈，默认关闭；打开前必须先执行 scripts/apm/fetch-agent.sh，
# 并用 `docker compose -f docker/docker-compose.yml --profile apm up -d` 启动辅助栈。
# 打开后 dev-init.sh 只给九个业务服务追加 -javaagent，不改代码、依赖与 OTLP 配置。
IBOOT_SKYWALKING_ENABLED=false
# Agent 发行包路径；留空时使用 docker/skywalking/agent/skywalking-agent.jar
IBOOT_SKYWALKING_AGENT=
# OAP gRPC 上报地址；宿主机进程默认 127.0.0.1:11800
IBOOT_SKYWALKING_OAP=127.0.0.1:11800

# Kibana 9.5 禁止使用 elastic 超级用户；该密码由 elasticsearch-init 幂等同步
KIBANA_SYSTEM_PASSWORD=iboot-dev-kibana
# Grafana 管理员口令；匿名访问只读，管理员必须显式登录
GRAFANA_ADMIN_PASSWORD=iboot-dev-grafana
