# 本地开发环境变量，复制为 scripts/dev.env 后填写；该文件已在 .gitignore 中。
# dev-init.sh 会在启动服务前自动加载。

# 必填：iboot-ai 启动时校验，缺失会直接退出
DASHSCOPE_CHAT_API_KEY=

# 可选：向量化与 OCR 使用不同的模型服务时填写
# DASHSCOPE_EMBEDDING_API_KEY=
# DASHSCOPE_OCR_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# 可选：配置了邮件服务器时健康检查才会包含邮件项
# MAIL_HOST=
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
