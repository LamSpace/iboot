{
  "components": {
    "schemas": {
      "CreatePersonalAccessTokenRequest": {
        "description": "创建个人访问令牌请求",
        "properties": {
          "expiresDays": {
            "description": "有效期天数；为空时使用默认值",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "description": "令牌名称，便于识别用途",
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "scopes": {
            "description": "权限码范围；为空时继承用户全部权限",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "PersonalAccessTokenCreatedResponse": {
        "description": "新签发的个人访问令牌",
        "properties": {
          "createdAt": {
            "description": "创建时间",
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "description": "过期时间",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "记录 ID",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "description": "令牌名称",
            "type": "string"
          },
          "scopes": {
            "description": "权限码范围；为空表示继承全部权限",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "token": {
            "description": "令牌明文，只返回一次",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PersonalAccessTokenResponse": {
        "description": "个人访问令牌列表项",
        "properties": {
          "createdAt": {
            "description": "创建时间",
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "description": "过期时间",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "记录 ID",
            "format": "int64",
            "type": "integer"
          },
          "lastUsedAt": {
            "description": "最近使用时间",
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "令牌名称",
            "type": "string"
          },
          "scopes": {
            "description": "权限码范围；为空表示继承全部权限",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "description": "状态：ACTIVE、REVOKED、EXPIRED",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RegisterRequest": {
        "description": "用户注册请求",
        "properties": {
          "confirmPassword": {
            "description": "确认密码",
            "minLength": 1,
            "type": "string"
          },
          "nickname": {
            "description": "昵称",
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "description": "密码",
            "maxLength": 20,
            "minLength": 6,
            "type": "string"
